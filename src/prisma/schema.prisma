// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(cuid(2))
  name     String?
  email    String    @unique
  password String
  Vehicle  Vehicle[]
}

model Vehicle {
  id               String             @id @default(cuid(2))
  name             String
  model            String?
  make             String?
  year             Int?
  odometer         Int?
  useKm            Boolean
  owner            User               @relation(fields: [userId], references: [id])
  userId           String
  MaintenanceItem  MaintenanceItem[]
  MaintenanceEntry MaintenanceEntry[]
}

model MaintenanceItem {
  id                 Int                @id @default(autoincrement())
  name               String
  comments           String?
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  timeIntervalDays   Int?
  usageIntervalMiles Float? // float so if there's probably a conversion from Km
  recurring          Boolean
  vehicleId          String
  MaintenanceEntry   MaintenanceEntry[]
}

model MaintenanceEntry {
  id                Int              @id @default(autoincrement())
  title             String
  details           String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  date              DateTime
  vehicleId         String
  maintenanceItemId Int?
  MaintenanceItem   MaintenanceItem? @relation(fields: [maintenanceItemId], references: [id])
}
